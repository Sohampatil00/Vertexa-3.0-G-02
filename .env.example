# Export these variables in your shell; the API does not automatically load .env files.
# Project database: Supabase PostgreSQL. Replace placeholders before exporting.
GOVFIX_DATABASE_URL=postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@YOUR_POOLER_HOST:5432/postgres?sslmode=require
GOVFIX_POLICY_VERSION=demo-pilot-v1
GOVFIX_SESSION_MINUTES=60
GOVFIX_EVIDENCE_DIRECTORY=./var/evidence
GOVFIX_EVIDENCE_MAX_BYTES=5242880
# Set these values for private Storage and optional Supabase Auth.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key
# SUPABASE_STORAGE_BUCKET=evidence
# SQLite is available only for isolated tests or an explicitly selected local demo.
# GOVFIX_DATABASE_URL=sqlite:///./govfix.db
# Phase 5: server-only credentials; select private agents for each language.
# ELEVENLABS_API_KEY=server-only-api-key
# GOVFIX_ELEVENLABS_AGENT_EN=agent-from-provisioning
# GOVFIX_ELEVENLABS_AGENT_HI=agent-from-provisioning
# GOVFIX_ELEVENLABS_AGENT_MR=agent-from-provisioning
# GOVFIX_ELEVENLABS_WEBHOOK_SECRET=shared-webhook-secret
# GOVFIX_ELEVENLABS_VOICE_ID=account-voice-id-for-provisioning

# Database/storage configuration does not select the login provider.
GOVFIX_AUTH_PROVIDER=local
# Use supabase only after linking provisioned users.id to Supabase Auth UUIDs.

# API and worker use GOVFIX_DATABASE_URL with the restricted runtime login.
# Keep the owner URI private, only for migrations and account/policy administration.
# GOVFIX_MIGRATION_DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER:5432/postgres?sslmode=require
GOVFIX_LOGIN_ACCOUNT_LIMIT=5
GOVFIX_LOGIN_IP_LIMIT=30
GOVFIX_LOGIN_WINDOW_SECONDS=900
# Use a generated 32+ character secret shared by all API processes.
# GOVFIX_LOGIN_RATE_SECRET=replace-with-generated-secret

# Enable after provisioning the PostgreSQL runtime role.
GOVFIX_REQUIRE_RESTRICTED_ROLE=false
