# Export these variables in your shell; the API does not automatically load .env files.
GOVFIX_DATABASE_URL=sqlite:///./govfix.db
GOVFIX_POLICY_VERSION=demo-pilot-v1
GOVFIX_SESSION_MINUTES=60
GOVFIX_EVIDENCE_DIRECTORY=./var/evidence
GOVFIX_EVIDENCE_MAX_BYTES=5242880
# Set these values to enable Supabase Auth and private Storage.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key
# SUPABASE_STORAGE_BUCKET=evidence
# GOVFIX_DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
# Phase 5: server-only credentials; select private agents for each language.
# ELEVENLABS_API_KEY=server-only-api-key
# GOVFIX_ELEVENLABS_AGENT_EN=agent-from-provisioning
# GOVFIX_ELEVENLABS_AGENT_HI=agent-from-provisioning
# GOVFIX_ELEVENLABS_AGENT_MR=agent-from-provisioning
# GOVFIX_ELEVENLABS_WEBHOOK_SECRET=shared-webhook-secret
# GOVFIX_ELEVENLABS_VOICE_ID=account-voice-id-for-provisioning
